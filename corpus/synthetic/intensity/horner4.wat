(module
  (memory (export "mem") 16)
  (func $horner4 (export "main") (param $out i32) (param $in i32) (param $n i32)
    (local $i i32) (local $x i32) (local $r i32)
    (block $e (loop $l
      (br_if $e (i32.ge_s (local.get $i) (local.get $n)))
      (local.set $x (i32.load (i32.add (local.get $in) (i32.mul (local.get $i) (i32.const 4)))))
      (local.set $r (i32.const 1))
      (local.set $r (i32.add (i32.mul (local.get $r) (local.get $x)) (i32.const 3)))
      (local.set $r (i32.add (i32.mul (local.get $r) (local.get $x)) (i32.const 2)))
      (local.set $r (i32.add (i32.mul (local.get $r) (local.get $x)) (i32.const 1)))
      (local.set $r (i32.add (i32.mul (local.get $r) (local.get $x)) (i32.const 0)))
      (i32.store (i32.add (local.get $out) (i32.mul (local.get $i) (i32.const 4))) (local.get $r))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $l)))
  )
)
